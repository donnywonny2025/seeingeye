# ═══════════════════════════════════════════════
# THE SEEING EYE — Configuration
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in your keys.

# ── Speech-to-Text (Deepgram) ─────────────────
# Sign up: https://console.deepgram.com
# Free: $200 credit on signup
DEEPGRAM_API_KEY=

# ── LLM Provider (Groq — fastest) ────────────
# Sign up: https://console.groq.com/keys
# Free tier available
GROQ_API_KEY=

# ── Fallback LLM (Gemini) ────────────────────
# Sign up: https://aistudio.google.com/app/apikey
# Optional — used if Groq fails/rate-limits
GEMINI_API_KEY=

# ── Server ────────────────────────────────────
PORT=4400

# ── Deepgram Model ───────────────────────────
# Options: nova-2, nova-2-general, nova-2-meeting
DEEPGRAM_MODEL=nova-2

# ── Groq Model ───────────────────────────────
# Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ── HUD Settings ─────────────────────────────
HUD_WIDTH=420
HUD_HEIGHT=520
HUD_OPACITY=0.92
